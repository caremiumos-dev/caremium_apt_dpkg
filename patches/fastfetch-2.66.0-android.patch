diff -ruN -x build /tmp/ffp/fastfetch-2.66.0/src/detection/codec/codec_android_stub.c src/fastfetch-2.66.0/src/detection/codec/codec_android_stub.c
--- /tmp/ffp/fastfetch-2.66.0/src/detection/codec/codec_android_stub.c	1970-01-01 08:00:00.000000000 +0800
+++ src/fastfetch-2.66.0/src/detection/codec/codec_android_stub.c	2026-10-25 10:44:48.000584707 +0800
@@ -0,0 +1,9 @@
+/* Android codec detection is disabled for the NDK r21 build:
+ * codec_android.c relies on C23 __VA_OPT__ (via FF_LIBRARY_LOAD_* macros)
+ * and on AMediaCodec_getName(), which only exists in newer NDK platforms. */
+#include "codec.h"
+
+const char* ffDetectCodecNative(FFCodecOptions* options, FFlist* result /*list of FFCodecResult*/) {
+    FF_UNUSED(options, result);
+    return "Codec detection is not available in this build";
+}
