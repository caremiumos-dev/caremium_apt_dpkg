 /*
+ * Minimal FIFO that works with an incomplete value type (bionic's libc++
+ * instantiates std::deque's block size eagerly, which std::queue<Var> can't
+ * satisfy while Var is only forward-declared).
+ */
+template <typename T>
+class fifo
+{
+   std::vector<T> v;
+   size_t head = 0;
+
+   public:
+   bool empty() const { return head == v.size(); }
+   size_t size() const { return v.size() - head; }
+   T &front() { return v[head]; }
+   T const &front() const { return v[head]; }
+   void pop()
+   {
+      if (++head == v.size())
+      {
+         v.clear();
+         head = 0;
+      }
+   }
+   void push(T const &x) { v.push_back(x); }
+};
+
